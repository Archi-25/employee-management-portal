{
  "name": "employee-management-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "start:fr": "nx serve --configuration development,fr",
    "build": "nx build",
    "build:i18n": "nx build --configuration i18n",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "test:ci": "nx test --no-watch",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "extract-i18n": "nx extract-i18n",
    "serve:ssr": "node dist/employee-management-portal/server/server.mjs",
    "sonar": "sonar-scanner",
    "nx:build": "nx build employee-management-portal",
    "nx:graph": "nx graph",
    "serve:ssr:fr": "node dist/employee-management-portal/server/fr/server.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@ngrx/signals": "^22.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.5",
    "@angular-devkit/schematics": "^22.1.5",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@schematics/angular": "^22.1.5",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^28.0.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
}
